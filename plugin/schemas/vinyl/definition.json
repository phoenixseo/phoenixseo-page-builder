{
    "key": "group_sdcpb_component_vinyl",
    "title": "Record",
    "sdcpb_description": "An album with cover, release details and the full track list by side.",
    "sdcpb_icon": "album",
    "sdcpb_version": 1,
    "fields": [
        {
            "key": "field_sdc_vinyl_cover",
            "label": "Cover",
            "name": "cover",
            "type": "image",
            "instructions": "Square image, at least 600 px. Without it, the text moves up.",
            "required": 0,
            "return_format": "array",
            "preview_size": "medium"
        },
        {
            "key": "field_sdc_vinyl_artist",
            "label": "Artist",
            "name": "artist",
            "type": "text",
            "required": 1
        },
        {
            "key": "field_sdc_vinyl_album",
            "label": "Album",
            "name": "album",
            "type": "text",
            "required": 1
        },
        {
            "key": "field_sdc_vinyl_year",
            "label": "Year",
            "name": "year",
            "type": "number",
            "instructions": "Year of this release, not of the first publication.",
            "required": 0,
            "min": 1900,
            "max": 2100,
            "step": 1
        },
        {
            "key": "field_sdc_vinyl_label",
            "label": "Label",
            "name": "label",
            "type": "text",
            "required": 0
        },
        {
            "key": "field_sdc_vinyl_catalog",
            "label": "Catalogue number",
            "name": "catalog",
            "type": "text",
            "instructions": "Sits on the spine of the cover, often hyphenated: SHVL 804.",
            "required": 0
        },
        {
            "key": "field_sdc_vinyl_tracks",
            "label": "Tracks",
            "name": "tracks",
            "type": "repeater",
            "instructions": "The order here is the order on the record. The view assigns the number; it is not maintained here.",
            "required": 0,
            "layout": "table",
            "button_label": "Add track",
            "sub_fields": [
                {
                    "key": "field_sdc_vinyl_track_side",
                    "label": "Side",
                    "name": "side",
                    "type": "select",
                    "instructions": "Tracks on the same side sit together on the record.",
                    "required": 0,
                    "default_value": "A",
                    "choices": {
                        "A": "A",
                        "B": "B",
                        "C": "C",
                        "D": "D"
                    }
                },
                {
                    "key": "field_sdc_vinyl_track_title",
                    "label": "Title",
                    "name": "title",
                    "type": "text",
                    "required": 1
                },
                {
                    "key": "field_sdc_vinyl_track_duration",
                    "label": "Length",
                    "name": "duration",
                    "type": "text",
                    "instructions": "As m:ss, for example 3:42. Leave empty if unknown.",
                    "required": 0,
                    "placeholder": "3:42"
                }
            ]
        }
    ],
    "location": [
        [
            {
                "param": "sdcpb_component",
                "operator": "==",
                "value": "1"
            }
        ]
    ],
    "menu_order": 70,
    "position": "normal",
    "style": "default",
    "label_placement": "top",
