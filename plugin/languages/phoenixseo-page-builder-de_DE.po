msgstr "Unterfeld"

msgid "Add Field"
msgstr "Feld hinzufügen"

msgid "Add Subfield"
msgstr "Unterfeld hinzufügen"

msgid "Field Name"
msgstr "Feldname"

msgid "Field Type"
msgstr "Feldtyp"

msgid "Hint in the Editor"
msgstr "Hinweis im Editor"

